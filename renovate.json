{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/modules/nomad-cascadia/jobspecs/.*\\.hcl/"
      ],
      "matchStrings": [
        ".*\"(?<currentValue>.+)\"\\s*#\\s*image:\\s*(?<depName>.+)\\n"
      ],
      "datasourceTemplate": "docker"
      }
  ],
  "ignorePaths": [
    "docker/**"
  ],
  "prBodyNotes": ["@demophoon"]
}
